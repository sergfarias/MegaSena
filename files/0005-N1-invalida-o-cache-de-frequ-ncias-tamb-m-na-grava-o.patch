diff --git a/src/MegaSena.Infrastructure/Services/ImportadorConcursosService.cs b/src/MegaSena.Infrastructure/Services/ImportadorConcursosService.cs
index f60e46b..5784b2a 100644
--- a/src/MegaSena.Infrastructure/Services/ImportadorConcursosService.cs
+++ b/src/MegaSena.Infrastructure/Services/ImportadorConcursosService.cs
@@ -114,12 +114,8 @@ public class ImportadorConcursosService : BackgroundService
             // Salva a cada 50 concursos. Erro de banco sobe para o ExecuteAsync (retry curto).
             if (lote.Count >= tamanhoLote)
             {
-                if (lote.Count > 0)
-                {
-                    await repo.AdicionarVariosAsync(lote);
-                    _log.LogInformation("Salvos os últimos {Qtd} concursos no banco.", lote.Count);
-                    _cache.Remove("freq-dezenas"); 
-                }
+                await repo.AdicionarVariosAsync(lote);
+                _cache.Remove("freq-dezenas");
                 _log.LogInformation("Salvos {Qtd} concursos no banco.", lote.Count);
                 lote.Clear();
             }
@@ -128,6 +124,7 @@ public class ImportadorConcursosService : BackgroundService
         if (lote.Count > 0)
         {
             await repo.AdicionarVariosAsync(lote);
+            _cache.Remove("freq-dezenas"); // o caso comum é 1 concurso novo, que cai aqui
             _log.LogInformation("Salvos os últimos {Qtd} concursos no banco.", lote.Count);
         }
 
